# Copy this file to .env.local and fill in values. Never commit .env.local.
# Each *_PROVIDER picks an adapter in src/adapters/. "console" prints to the
# terminal instead of calling a real service, so local dev needs no accounts.

# Postgres connection string (Neon/Supabase/any). Empty = in-memory dev store.
DATABASE_URL=

# Sign-in provider, decided later (Supabase / Better Auth / own). "local" is
# our own email-OTP sign-in; codes and sessions go through the db adapter.
AUTH_PROVIDER=local

# "dev-inbox" shows emails at /dev/inbox (and in the terminal) instead of sending.
# "smtp" sends real email through any SMTP server (Brevo, Gmail, company).
EMAIL_PROVIDER=dev-inbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=

# ENIP app backend: "mock" until the app dev team shares API access.
ENIP_APP_PROVIDER=mock
ENIP_APP_API_URL=
ENIP_APP_API_KEY=
