# Copy this file to .env.local and fill in values. Never commit .env.local.
# Each *_PROVIDER picks an adapter in src/adapters/. "console" prints to the
# terminal instead of calling a real service, so local dev needs no accounts.

# Postgres connection string (Neon/Supabase/any). Required.
DATABASE_URL=

# HireLayer instant CV review. Keep the key server-side; never prefix it with NEXT_PUBLIC_.
HIRELAYER_API_KEY=
# Product economics are undecided. Leave blank to keep instant review disabled.
ENIP_INITIAL_POINTS=
ENIP_INSTANT_CV_REVIEW_COST=

# Sign-in provider, decided later (Supabase / Better Auth / own). "local" is
# our own email-OTP sign-in; codes and sessions go through the db adapter.
AUTH_PROVIDER=local

# "dev-inbox" shows emails at /dev/inbox (and in the terminal) instead of sending.
# "smtp" sends real email through any SMTP server (Brevo, Gmail, company).
EMAIL_PROVIDER=dev-inbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=

# Team inbox (/team): emails allowed to sign in and reply as the seniors,
# comma-separated. Example: TEAM_EMAILS=priya@yal.in,arjun@yal.in
TEAM_EMAILS=

# ENIP app backend. Phase 1 keeps seniors and chats in our own database
# (src/adapters/enip-app/local.ts); phase 2 adds the app's API.
ENIP_APP_PROVIDER=local
ENIP_APP_API_URL=
ENIP_APP_API_KEY=
